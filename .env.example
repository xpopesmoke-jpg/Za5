# Copy to .env.local for local development. On Coolify, set these as environment variables.

# Postgres connection string. Leave empty locally to use the built-in development database.
DATABASE_URL=

# A long random secret for logins. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address the app is served from, e.g. https://za5.yourdomain.com (http://localhost:3000 locally)
BETTER_AUTH_URL=http://localhost:3000
